datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  MARKETING
  SPV
  DEVELOPER
  PROJECT_ADMIN
}

enum UnitStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
  BLOCKED
}

enum CustomerPipelineStatus {
  NEW_LEAD
  FOLLOW_UP
  SUBMITTED_TO_SPV
  REVISION_SPV
  SUBMITTED_TO_DEV
  REVISION_DEV
  APPROVED_PENDING_BOOKING
  BOOKED
  KPR_PROCESSING
  AKAD_SCHEDULED
  AKAD_COMPLETED
  DROPPED
  REJECTED
}

enum ActivityType {
  CALL
  WHATSAPP
  SITE_VISIT
  MEETING
}

enum ApprovalStage {
  SPV_REVIEW
  DEVELOPER_REVIEW
}

enum ApprovalDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum RateSchemeType {
  COMMERCIAL
  FLPP_SUBSIDIZED
}

enum AffordabilityStatus {
  PASS
  WARNING
  FAIL
}

enum PaymentMethod {
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  QRIS
  CASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KprStatus {
  DOCUMENTS_COLLECTION
  SUBMITTED_TO_BANK
  BANK_CHECKING
  SURVEY_APPRAISAL
  SP3K_ISSUED
  SP3K_REJECTED
  AKAD_SCHEDULED
  AKAD_COMPLETED
}

enum DocumentType {
  KTP_PEMOHON
  KTP_PASANGAN
  KK
  NPWP
  SLIP_GAJI
  SURAT_KERJA
  REKENING_KORAN
  SPT_PPH21
  SURAT_BELUM_RUMAH
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  EXHIBITION
  BROCHURE
  REFERRAL
  WALK_IN
  WEBSITE
  OTHER
}

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(50)
  email       String   @db.VarChar(100)
  phone       String   @db.VarChar(30)
  address     String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.Text
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users     User[]
  projects  Project[]
  banks     Bank[]
  customers Customer[]
  units     Unit[]
  auditLogs AuditLog[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  role         UserRole
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.Text
  phoneNumber  String    @map("phone_number") @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  managedLeads         Customer[]         @relation("MarketingCustomer")
  activitiesLogged     FollowUpActivity[]
  approvalsDecided     Approval[]
  bookingVerifications BookingPayment[]   @relation("BookingVerifier")
  spvTeamSupervised    SpvTeam[]          @relation("SpvUser")
  spvTeamMember        SpvTeam[]          @relation("MarketingUser")
  projectAssignments   UserProjectAssignment[]

  @@index([tenantId, role])
  @@map("users")
}

model SpvTeam {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  spvUserId       String   @map("spv_user_id") @db.Uuid
  marketingUserId String   @map("marketing_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  spv       User @relation("SpvUser", fields: [spvUserId], references: [id], onDelete: Cascade)
  marketing User @relation("MarketingUser", fields: [marketingUserId], references: [id], onDelete: Cascade)

  @@unique([spvUserId, marketingUserId])
  @@map("spv_teams")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(150)
  code        String   @db.VarChar(20)
  city        String   @db.VarChar(100)
  province    String   @db.VarChar(100)
  address     String   @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blocks      Block[]
  units       Unit[]
  customers   Customer[]
  assignments UserProjectAssignment[]

  @@index([tenantId])
  @@map("projects")
}

model UserProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("user_project_assignments")
}

model Block {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(50)
  description String?  @db.Text

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units       Unit[]

  @@index([projectId])
  @@map("blocks")
}

model Unit {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  projectId         String     @map("project_id") @db.Uuid
  blockId           String     @map("block_id") @db.Uuid
  unitNumber        String     @map("unit_number") @db.VarChar(20)
  unitType          String     @map("unit_type") @db.VarChar(50)
  landAreaM2        Decimal    @map("land_area_m2") @db.Decimal(8, 2)
  buildingAreaM2    Decimal    @map("building_area_m2") @db.Decimal(8, 2)
  bedrooms          Int        @default(2)
  bathrooms         Int        @default(1)
  basePrice         Decimal    @map("base_price") @db.Decimal(15, 2)
  bookingFeeAmount  Decimal    @default(5000000.00) @map("booking_fee_amount") @db.Decimal(12, 2)
  status            UnitStatus @default(AVAILABLE)
  holdExpiresAt     DateTime?  @map("hold_expires_at") @db.Timestamptz()
  currentCustomerId String?    @map("current_customer_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  block               Block            @relation(fields: [blockId], references: [id], onDelete: Cascade)
  interestedCustomers Customer[]
  bookingPayments     BookingPayment[]
  kprApplications     KprApplication[]

  @@unique([projectId, blockId, unitNumber])
  @@index([tenantId, status])
  @@index([status, holdExpiresAt])
  @@map("units")
}

model Customer {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  marketingId         String                 @map("marketing_id") @db.Uuid
  projectId           String                 @map("project_id") @db.Uuid
  interestedUnitId    String?                @map("interested_unit_id") @db.Uuid
  pipelineStatus      CustomerPipelineStatus @default(NEW_LEAD) @map("pipeline_status")
  fullName            String                 @map("full_name") @db.VarChar(150)
  phoneNumber         String                 @map("phone_number") @db.VarChar(30)
  email               String?                @db.VarChar(150)
  nik                 String?                @db.VarChar(30)
  npwp                String?                @db.VarChar(30)
  address             String?                @db.Text
  occupation          String?                @db.VarChar(100)
  monthlyIncome       Decimal                @default(0.00) @map("monthly_income") @db.Decimal(14, 2)
  existingObligations Decimal                @default(0.00) @map("existing_obligations") @db.Decimal(14, 2)
  leadSource          LeadSource             @default(OTHER) @map("lead_source")
  nextFollowUpDate    DateTime?              @map("next_follow_up_date") @db.Timestamptz()
  notes               String?                @db.Text
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marketing       User               @relation("MarketingCustomer", fields: [marketingId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  interestedUnit  Unit?              @relation(fields: [interestedUnitId], references: [id], onDelete: SetNull)
  activities      FollowUpActivity[]
  approvals       Approval[]
  simulations     KprSimulation[]
  bookingPayments BookingPayment[]
  kprApplication  KprApplication?

  @@index([tenantId, marketingId])
  @@index([tenantId, pipelineStatus])
  @@map("customers")
}

model FollowUpActivity {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  activityType     ActivityType @map("activity_type")
  outcomeNotes     String       @map("outcome_notes") @db.Text
  followUpDate     DateTime     @default(now()) @map("follow_up_date") @db.Timestamptz()
  nextFollowUpDate DateTime     @map("next_follow_up_date") @db.Timestamptz()
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("follow_up_activities")
}

model Approval {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  stage      ApprovalStage
  decision   ApprovalDecision
  notes      String           @db.Text
  decidedBy  String           @map("decided_by") @db.Uuid
  decidedAt  DateTime         @default(now()) @map("decided_at") @db.Timestamptz()

  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  approver   User             @relation(fields: [decidedBy], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("approvals")
}

model Bank {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  code     String       @db.VarChar(20)
  name     String       @db.VarChar(100)
  logoUrl  String?      @map("logo_url") @db.Text
  isActive Boolean      @default(true) @map("is_active")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  presets  RatePreset[]
  kprApps  KprApplication[]

  @@unique([tenantId, code])
  @@map("banks")
}

model RatePreset {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  bankId           String         @map("bank_id") @db.Uuid
  name             String         @db.VarChar(100)
  schemeType       RateSchemeType @map("scheme_type")
  fixedRatePct     Decimal        @map("fixed_rate_pct") @db.Decimal(5, 2)
  fixedPeriodYears Int            @default(0) @map("fixed_period_years")
  floatingRatePct  Decimal        @default(0.00) @map("floating_rate_pct") @db.Decimal(5, 2)
  minDpPct         Decimal        @default(10.00) @map("min_dp_pct") @db.Decimal(5, 2)
  maxTenorYears    Int            @default(20) @map("max_tenor_years")
  isActive         Boolean        @default(true) @map("is_active")

  bank             Bank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  simulations      KprSimulation[]

  @@index([bankId])
  @@map("rate_presets")
}

model KprSimulation {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  customerId          String              @map("customer_id") @db.Uuid
  ratePresetId        String              @map("rate_preset_id") @db.Uuid
  unitPrice           Decimal             @map("unit_price") @db.Decimal(15, 2)
  dpAmount            Decimal             @map("dp_amount") @db.Decimal(15, 2)
  dpPercentage        Decimal             @map("dp_percentage") @db.Decimal(5, 2)
  loanAmount          Decimal             @map("loan_amount") @db.Decimal(15, 2)
  tenorYears          Int                 @map("tenor_years")
  monthlyInstallment  Decimal             @map("monthly_installment") @db.Decimal(15, 2)
  dsrPercentage       Decimal             @map("dsr_percentage") @db.Decimal(5, 2)
  affordabilityStatus AffordabilityStatus @map("affordability_status")
  scheduleJson        Json                @map("schedule_json")
  isPrimary           Boolean             @default(true) @map("is_primary")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ratePreset      RatePreset       @relation(fields: [ratePresetId], references: [id], onDelete: Cascade)
  kprApplications KprApplication[]

  @@index([customerId])
  @@map("kpr_simulations")
}

model BookingPayment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  unitId        String        @map("unit_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @map("payment_date") @db.Timestamptz()
  paymentMethod PaymentMethod @map("payment_method")
  receiptUrl    String        @map("receipt_url") @db.Text
  status        PaymentStatus @default(PENDING)
  verifiedBy    String?       @map("verified_by") @db.Uuid
  verifiedAt    DateTime?     @map("verified_at") @db.Timestamptz()
  notes         String?       @db.Text

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  verifier      User?         @relation("BookingVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([unitId])
  @@map("booking_payments")
}

model KprApplication {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  customerId         String         @unique @map("customer_id") @db.Uuid
  unitId             String         @map("unit_id") @db.Uuid
  bankId             String         @map("bank_id") @db.Uuid
  simulationId       String         @map("simulation_id") @db.Uuid
  status             KprStatus      @default(DOCUMENTS_COLLECTION)
  sp3kNumber         String?        @map("sp3k_number") @db.VarChar(100)
  sp3kIssuedAt       DateTime?      @map("sp3k_issued_at") @db.Timestamptz()
  approvedLoanAmount Decimal?       @map("approved_loan_amount") @db.Decimal(15, 2)
  rejectionReason    String?        @map("rejection_reason") @db.Text
  akadScheduledAt    DateTime?      @map("akad_scheduled_at") @db.Timestamptz()
  notaryName         String?        @map("notary_name") @db.VarChar(100)
  notes              String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bank       Bank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  simulation KprSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  documents  KprDocument[]

  @@index([tenantId, status])
  @@map("kpr_applications")
}

model KprDocument {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  kprApplicationId String             @map("kpr_application_id") @db.Uuid
  documentType     DocumentType       @map("document_type")
  fileUrl          String             @map("file_url") @db.Text
  fileName         String             @map("file_name") @db.VarChar(255)
  fileSizeBytes    Int                @map("file_size_bytes")
  mimeType         String             @map("mime_type") @db.VarChar(50)
  status           VerificationStatus @default(PENDING)
  verifiedBy       String?            @map("verified_by") @db.Uuid
  rejectionReason  String?            @map("rejection_reason") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  kprApplication   KprApplication     @relation(fields: [kprApplicationId], references: [id], onDelete: Cascade)

  @@index([kprApplicationId])
  @@map("kpr_documents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  changes    Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
